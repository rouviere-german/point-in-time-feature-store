# Copy to .env for local runs. Never commit .env. Every variable is optional in dev.
APP_SERVICE_NAME=point-in-time-feature-store
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false

# /metrics scraping: comma-separated lowercase SHA-256 digests of API keys.
# Generate a key with: uv run pitfs generate-api-key
APP_API_KEY_SHA256=
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=50
APP_RATE_LIMIT_BURST=200
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=65536
APP_METRICS_REQUIRE_AUTH=true

# Caller authentication: path to the token issuer's Ed25519 public key (PEM).
# Generate development keys with: uv run pitfs generate-keys --out-dir var/keys
APP_JWT_PUBLIC_KEY_PATH=
APP_JWT_ISSUER=pitfs-dev-issuer
APP_JWT_AUDIENCE=point-in-time-feature-store
# Tokens whose exp - iat exceeds this many seconds are refused (there is no revocation list).
APP_JWT_MAX_TOKEN_LIFETIME_SECONDS=3600

APP_TRACING_EXPORTER=none
# HMAC key (>= 32 characters) for entity ids in logs, audit records and receipts. Required in prod.
APP_LOG_HMAC_KEY=

# Online store. The password must belong to the restricted ACL user (see pitfs redis-acl).
APP_REDIS_URL=redis://127.0.0.1:6379/0
APP_REDIS_USERNAME=pitfs_app
APP_REDIS_PASSWORD=
APP_ONLINE_MAX_BATCH_ENTITIES=100
APP_ONLINE_MAX_FEATURES=200
APP_REQUEST_LOG_SAMPLE_RATE=0.1

# Offline store, registry and erasure receipts.
APP_DATA_DIR=var
APP_RECEIPT_SIGNING_KEY_PATH=
APP_DUCKDB_THREADS=2
APP_DUCKDB_MEMORY_LIMIT=1GB
